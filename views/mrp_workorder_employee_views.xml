<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_employee_my_workorders" model="ir.actions.act_window">
        <field name="name">My Work Orders</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="domain">[('state', 'not in', ('done', 'cancel')), '|', ('workcenter_id.employee_ids', '=', False), ('workcenter_id.employee_ids.user_id', '=', uid)]</field>
    </record>

    <menuitem id="menu_employee_my_workorders"
              name="My Work Orders"
              parent="mrp.menu_mrp_manufacturing"
              action="action_employee_my_workorders"
              groups="mrp.group_mrp_user,hr.group_hr_user"
              sequence="2"/>

    <record id="mrp_workorder_employee_session_form" model="ir.ui.view">
        <field name="name">mrp.workorder.form.employee.session</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Employee Sessions">
                    <field name="employee_session_count" invisible="1"/>
                    <field name="is_user_working" invisible="1"/>
                    <field name="employee_hours" readonly="1"/>
                    <field name="employee_cost" readonly="1"/>
                    <field name="employee_produced_quantity" readonly="1"/>
                    <field name="employee_session_ids" readonly="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                            <field name="duration_hours"/>
                            <field name="cost_amount"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
