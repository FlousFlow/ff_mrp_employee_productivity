<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_production_line_list" model="ir.ui.view">
        <field name="name">ff.mrp.employee.production.line.list</field>
        <field name="model">ff.mrp.employee.production.line</field>
        <field name="arch" type="xml">
            <list string="Employee Production" create="false">
                <field name="production_date"/>
                <field name="employee_id"/>
                <field name="production_id"/>
                <field name="workorder_id"/>
                <field name="workcenter_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="production_state"/>
                <field name="report_eligible"/>
                <field name="approval_state"/>
                <field name="payroll_state"/>
            </list>
        </field>
    </record>

    <record id="view_employee_production_line_form" model="ir.ui.view">
        <field name="name">ff.mrp.employee.production.line.form</field>
        <field name="model">ff.mrp.employee.production.line</field>
        <field name="arch" type="xml">
            <form string="Employee Production">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="approval_state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-success" invisible="approval_state != 'submitted'" groups="mrp.group_mrp_manager"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="approval_state != 'submitted'" groups="mrp.group_mrp_manager"/>
                    <field name="approval_state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="production_id"/>
                        <field name="workorder_id"/>
                        <field name="workcenter_id" readonly="1"/>
                        <field name="production_date"/>
                        <field name="quantity"/>
                        <field name="approval_state" readonly="1"/>
                        <field name="approved_by" readonly="1"/>
                        <field name="payroll_state" readonly="1"/>
                        <field name="payroll_input_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="product_uom_id" readonly="1" groups="uom.group_uom"/>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                    </group>
                    <group string="Validation">
                        <field name="production_state" readonly="1"/>
                        <field name="production_status" readonly="1"/>
                        <field name="report_eligible" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_production_line_pivot" model="ir.ui.view">
        <field name="name">ff.mrp.employee.production.line.pivot</field>
        <field name="model">ff.mrp.employee.production.line</field>
        <field name="arch" type="xml">
            <pivot string="Employee Production">
                <field name="employee_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="production_date" type="col" interval="month"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_employee_production_line_graph" model="ir.ui.view">
        <field name="name">ff.mrp.employee.production.line.graph</field>
        <field name="model">ff.mrp.employee.production.line</field>
        <field name="arch" type="xml">
            <graph string="Employee Production" type="bar">
                <field name="employee_id" type="row"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_employee_production_line_search" model="ir.ui.view">
        <field name="name">ff.mrp.employee.production.line.search</field>
        <field name="model">ff.mrp.employee.production.line</field>
        <field name="arch" type="xml">
            <search string="Employee Production">
                <field name="employee_id"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="production_date"/>
                <field name="company_id"/>
                <filter name="eligible" string="Completed Production"
                        domain="[('report_eligible', '=', True)]"/>
                <separator/>
                <filter name="group_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter name="group_product" string="Product"
                        context="{'group_by': 'product_id'}"/>
                <filter name="group_date" string="Production Date"
                        context="{'group_by': 'production_date'}"/>
                <filter name="group_month" string="Month"
                        context="{'group_by': 'production_date:month'}"/>
                <filter name="group_production" string="Manufacturing Order"
                        context="{'group_by': 'production_id'}"/>
                <filter name="group_company" string="Company"
                        context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_employee_production_line" model="ir.actions.act_window">
        <field name="name">Employee Production</field>
        <field name="res_model">ff.mrp.employee.production.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="view_id" ref="view_employee_production_line_list"/>
        <field name="search_view_id" ref="view_employee_production_line_search"/>
        <field name="domain">[('report_eligible', '=', True)]</field>
        <field name="context">{'search_default_eligible': 1}</field>
    </record>

    <record id="action_employee_production_pending_approval" model="ir.actions.act_window">
        <field name="name">Production Approval</field>
        <field name="res_model">ff.mrp.employee.production.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_employee_production_line_list"/>
        <field name="domain">[('approval_state', '=', 'submitted')]</field>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

    <menuitem id="menu_employee_production_line"
              name="Employee Production"
              parent="mrp.menu_mrp_reporting"
              action="action_employee_production_line"
              groups="mrp.group_mrp_user,hr.group_hr_user"
              sequence="30"/>
    <menuitem id="menu_employee_production_pending_approval"
              name="Production Approval"
              parent="mrp.menu_mrp_reporting"
              action="action_employee_production_pending_approval"
              groups="mrp.group_mrp_manager"
              sequence="31"/>
</odoo>
