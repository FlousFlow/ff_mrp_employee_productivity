<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_employee_productivity" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.employee.productivity</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']//group[@name='capacity']" position="inside">
                <separator string="Production Employees"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <label for="employee_costs_hour"/>
                <div class="o_row">
                    <field name="employee_costs_hour" widget="monetary"/>
                    <span>per employee / hour</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
