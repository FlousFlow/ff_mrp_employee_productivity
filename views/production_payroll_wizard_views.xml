<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_payroll_wizard_form" model="ir.ui.view">
        <field name="name">ff.mrp.production.payroll.wizard.form</field>
        <field name="model">ff.mrp.production.payroll.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Production to Payroll">
                <group>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="rule_id"/>
                </group>
                <footer>
                    <button name="action_send_to_payroll" type="object" string="Send to Payroll" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_production_payroll_wizard" model="ir.actions.act_window">
        <field name="name">Send Production to Payroll</field>
        <field name="res_model">ff.mrp.production.payroll.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_production_payroll_wizard" name="Send Production to Payroll"
              parent="mrp.menu_mrp_reporting" action="action_production_payroll_wizard"
              groups="mrp.group_mrp_user" sequence="32"/>
</odoo>
