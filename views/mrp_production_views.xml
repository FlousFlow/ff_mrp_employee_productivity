<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_employee_productivity" model="ir.ui.view">
        <field name="name">mrp.production.form.employee.productivity</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <page name="components" position="after">
                <page name="production_employees" string="Production Employees"
                      groups="mrp.group_mrp_user">
                    <group>
                        <group string="Distribution Summary">
                            <field name="qty_produced" readonly="1"/>
                            <field name="employee_production_qty" readonly="1"/>
                            <field name="employee_unassigned_qty" readonly="1"/>
                            <field name="employee_overassigned_qty" readonly="1"
                                   invisible="employee_overassigned_qty == 0"/>
                        </group>
                        <group string="Status">
                            <field name="employee_production_status" readonly="1"/>
                            <field name="employee_production_reportable" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert"
                         invisible="employee_production_status != 'over_assigned'">
                        Employee quantities exceed the actual manufactured quantity.
                        Correct the distribution before reporting.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="employee_production_status not in ('unassigned', 'in_progress')">
                        Employee quantities are provisional until manufacturing is completed.
                    </div>
                    <field name="employee_production_line_ids"
                           context="{'default_production_id': id}"
                           readonly="state == 'cancel'">
                        <list editable="bottom">
                            <field name="workorder_id"
                                   domain="[('production_id', '=', parent.id)]"
                                   required="1"/>
                            <field name="workcenter_id" readonly="1"/>
                            <field name="employee_id"
                                   domain="[('id', 'in', allowed_employee_ids)]"
                                   required="1"/>
                            <field name="allowed_employee_ids" column_invisible="1"/>
                            <field name="production_date"/>
                            <field name="quantity"/>
                            <field name="approval_state" readonly="1"/>
                            <field name="product_uom_id" readonly="1" groups="uom.group_uom"/>
                            <field name="production_state" column_invisible="1"/>
                            <field name="production_status" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
