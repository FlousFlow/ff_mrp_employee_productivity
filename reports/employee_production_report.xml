<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_employee_production_statement" model="report.paperformat">
        <field name="name">Employee Production Statement A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_employee_production_statement" model="ir.actions.report">
        <field name="name">Employee Production Statement</field>
        <field name="model">ff.mrp.employee.production.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ff_mrp_employee_productivity.employee_production_statement</field>
        <field name="report_file">ff_mrp_employee_productivity.employee_production_statement</field>
        <field name="paperformat_id" ref="paperformat_employee_production_statement"/>
        <field name="print_report_name">'Employee Production - %s' % (object.employee_id.name or 'Employees')</field>
    </record>
</odoo>
