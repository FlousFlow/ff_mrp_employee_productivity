<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="employee_production_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-foreach="wizard.get_report_sections()" t-as="section">
                    <t t-call="web.external_layout">
                        <div class="page" dir="rtl" style="direction: rtl;">
                            <h2>Employee Production Statement</h2>
                            <div class="row mt-3 mb-3">
                                <div class="col-6">
                                    <strong>Employee:</strong>
                                    <span t-esc="section['employee'].display_name"/>
                                    <br/>
                                    <strong>Department:</strong>
                                    <span t-esc="section['employee'].department_id.display_name or ''"/>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Date From:</strong> <span t-esc="wizard.date_from"/><br/>
                                    <strong>Date To:</strong> <span t-esc="wizard.date_to"/><br/>
                                    <strong>Print Date:</strong>
                                    <span t-esc="context_timestamp(wizard.print_datetime).strftime('%Y-%m-%d %H:%M')"/>
                                </div>
                            </div>

                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th t-if="wizard.show_order_details">Manufacturing Order</th>
                                        <th>Product</th>
                                        <th class="text-end">Quantity</th>
                                        <th>UoM</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="section['lines']" t-as="line">
                                        <td t-esc="line.production_date"/>
                                        <td t-if="wizard.show_order_details" t-esc="line.production_id.display_name"/>
                                        <td t-esc="line.product_id.display_name"/>
                                        <td class="text-end" t-esc="line.quantity"/>
                                        <td t-esc="line.product_uom_id.display_name"/>
                                    </tr>
                                    <tr t-if="not section['lines']">
                                        <td t-att-colspan="5 if wizard.show_order_details else 4" class="text-center">No eligible production records.</td>
                                    </tr>
                                </tbody>
                            </table>

                            <h4 class="mt-4">Summary</h4>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>UoM</th>
                                        <th class="text-end">Total Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="section['summary']" t-as="item">
                                        <td t-esc="item['product']"/>
                                        <td t-esc="item['uom']"/>
                                        <td class="text-end" t-esc="item['quantity']"/>
                                    </tr>
                                </tbody>
                            </table>
                            <p>
                                <strong>Manufacturing Orders:</strong>
                                <span t-esc="section['order_count']"/>
                            </p>
                            <div class="row mt-5">
                                <div class="col-6">Production Supervisor: ____________________</div>
                                <div class="col-6">Reviewer: ____________________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
